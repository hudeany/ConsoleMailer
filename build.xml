<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project default="build_jar" name="Create all Jars for Project ConsoleMailer">
	<property name="antbuildhelp.version" value="26.0.3" />

	<property name="bcjmail.version" value="1.80" />
	<property name="bcpg.version" value="1.80" />
	<property name="bcpkix.version" value="1.80" />
	<property name="bcprov.version" value="1.80" />
	<property name="bcutil.version" value="1.80" />
	<property name="jakarta-activation-api.version" value="2.1.3" />
	<property name="jakarta-mail-api.version" value="2.1.3" />
	<property name="angus-mail.version" value="2.0.3" />
	<property name="angus-activation.version" value="2.0.2" />
	<property name="dkim.version" value="26.1.1" />
	<property name="json.version" value="26.2.3" />
	<property name="proxyautoconfig.version" value="26.1.1" />
	<property name="network.version" value="26.0.31" />
	<property name="soderer-utilities.version" value="26.2.53" />

	<target name="build_jar" depends="build_setup, cleanup_before, create_jar, sign_jar, cleanup_after" />

	<target name="probe-proxy">
		<condition property="proxy.enabled">
			<and>
				<isset property="proxy.host" />
				<isreachable host="${proxy.host}" />
			</and>
		</condition>
	</target>

	<target name="proxy" depends="probe-proxy" if="proxy.enabled">
		<property name="proxy.port" value="80" />
		<property name="proxy.user" value="" />
		<property name="proxy.pass" value="" />
		<setproxy proxyhost="${proxy.host}" proxyport="${proxy.port}" proxyuser="${proxy.user}" proxypassword="${proxy.pass}" />
	</target>

	<available file="lib_build/antbuildhelp-${antbuildhelp.version}.jar" property="antbuildhelp.available" />
	<target name="get_antbuildhelp" unless="antbuildhelp.available">
		<mkdir dir="lib_build/" />
		<delete>
			<fileset dir="lib_build" includes="antbuildhelp-*.jar" />
		</delete>
		<get src="https://github.com/hudeany/antbuildhelp/releases/download/${antbuildhelp.version}/antbuildhelp-${antbuildhelp.version}.jar" dest="lib_build/" />
	</target>

	<!-- typedef must run on every build (Ant doesn't remember task registrations between runs),
	     so it lives in its own target with no "unless" - not inside get_antbuildhelp, which is
	     skipped whenever the jar is already cached from a previous run. -->
	<target name="register_antbuildhelp" depends="get_antbuildhelp">
		<typedef resource="de/soderer/antbuildhelp/antlib.xml" classpath="lib_build/antbuildhelp-${antbuildhelp.version}.jar" />
	</target>

	<target name="build_setup" depends="register_antbuildhelp">
		<loadfile property="build.version" srcFile="build.version" failonerror="false" />
		<property name="build.version" value="25.0.0" />
		<echo message="build.version: ${build.version}" />

		<property file="${user.home}/git/codeSigning.properties" />

		<tstamp>
			<format property="buildTime" pattern="yyyy-mm-dd HH:mm:ss" locale="en"/>
		</tstamp>
		<echo message="buildTime: ${buildTime}" />

		<property name="buildPath" value="build" />
		<echo message="buildPath: ${buildPath}" />
	</target>

	<target name="cleanup_before">
		<delete dir="${buildPath}/bin" />
		<mkdir dir="${buildPath}/bin" />
	</target>

	<target name="cleanup_after">
		<delete dir="${buildPath}/bin" />
	</target>

	<target name="download_dependencies" depends="proxy">
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcjmail-jdk18on" version="${bcjmail.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcpg-jdk18on" version="${bcpg.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcpkix-jdk18on" version="${bcpkix.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcprov-jdk18on" version="${bcprov.version}" />
		<getMavenDependency groupId="org.bouncycastle" artifactId="bcutil-jdk18on" version="${bcutil.version}" />
		<getMavenDependency groupId="jakarta.activation" artifactId="jakarta.activation-api" version="${jakarta-activation-api.version}" />
		<getMavenDependency groupId="jakarta.mail" artifactId="jakarta.mail-api" version="${jakarta-mail-api.version}" />
		<getMavenDependency groupId="org.eclipse.angus" artifactId="angus-mail" version="${angus-mail.version}" />
		<getMavenDependency groupId="org.eclipse.angus" artifactId="angus-activation" version="${angus-activation.version}" />

		<getDependency name="dkim" version="${dkim.version}" url="https://github.com/hudeany/dkim/releases/download/{version}/dkim-{version}.jar" />
		<getDependency name="json" version="${json.version}" url="https://github.com/hudeany/json/releases/download/{version}/json-{version}.jar" />
		<getDependency name="proxyautoconfig" version="${proxyautoconfig.version}" url="https://github.com/hudeany/ProxyAutoConfig/releases/download/{version}/proxyautoconfig-{version}.jar" />
		<getDependency name="network" version="${network.version}" url="https://github.com/hudeany/network/releases/download/{version}/network-{version}.jar" />

		<getMavenDependency repositoryUrl="https://soderer.de/maven2" groupId="de.soderer" artifactId="soderer-utilities" version="${soderer-utilities.version}" />
		<getMavenDependency repositoryUrl="https://soderer.de/maven2" groupId="de.soderer" artifactId="soderer-utilities" version="${soderer-utilities.version}" classifier="sources" />
	</target>

	<target name="compile" depends="download_dependencies">
		<path id="build.classpath">
			<fileset dir="lib">
				<include name="*.jar" />
			</fileset>
		</path>

		<javac release="17" debug="true" nowarn="true" deprecation="false" destdir="${buildPath}/bin" fork="yes" srcdir="src" includeantruntime="false" encoding="UTF-8" classpath="lib/*">
			<classpath refid="build.classpath" />
			<compilerarg value="-Xlint:unchecked" />
			<compilerarg value="-parameters" />
		</javac>

		<copy todir="${buildPath}/bin">
			<fileset dir="src/main/resources">
				<include name="**/*.txt" />
			</fileset>
		</copy>
	</target>

	<target name="determine_ca_public_key_file_names" if="codeSigningPropertiesAvailable">
		<basename property="CaPublicKeyFileName" file="${CaPublicKey}"/>
		<basename property="CaPublicKeyFileNameOld" file="${CaPublicKeyOld}"/>
	</target>

	<target name="create_versionfile" depends="determine_ca_public_key_file_names">
		<property name="CaPublicKeyFileName" value="" />
		<property name="CaPublicKeyFileNameOld" value="" />

		<delete file="${buildPath}/bin/version.txt" />
		<echo file="${buildPath}/bin/version.txt" append="false">${build.version}${line.separator}${buildTime}${line.separator}${VersionsUrl}${line.separator}${CaPublicKeyFileName}, ${CaPublicKeyFileNameOld}${line.separator}</echo>
		<delete file="src/main/resources/version.txt" />
		<echo file="src/main/resources/version.txt" append="false">${build.version}${line.separator}${buildTime}${line.separator}${VersionsUrl}${line.separator}${CaPublicKeyFileName}, ${CaPublicKeyFileNameOld}${line.separator}</echo>
	</target>

	<target name="create_jar" depends="compile, create_versionfile">
		<jar destfile="${buildPath}/ConsoleMailer-${build.version}.jar">
			<manifest>
				<attribute name="Main-Class" value="de.soderer.ConsoleMailer" />
				<attribute name="Class-Path" value="." />
				<attribute name="Rsrc-Main-Class" value="de.soderer.mailer.ConsoleMailer" />
			</manifest>

			<fileset dir="${buildPath}/bin" />

			<zipfileset dir="lib" includes="*.jar" excludes="*sources.jar" />
		</jar>
	</target>

	<available file="${user.home}/git/codeSigning.properties" property="codeSigningPropertiesAvailable" />

	<!-- Two-pass jar build: only "if"/"unless" on <target> is universally reliable across Ant
	     versions (some Ant versions don't honor the generic if/unless on individual nested
	     elements like <zipfileset>). So the CA certificates are added in a second, separate
	     "update" pass over the already-built jar, guarded at target level, instead of as a
	     conditional zipfileset entry inside create_jar itself. -->
	<target name="add_ca_certificates_to_jar" depends="create_jar" if="codeSigningPropertiesAvailable">
		<jar destfile="${buildPath}/ConsoleMailer-${build.version}.jar" update="true">
			<zipfileset file="${CaPublicKey}" />
			<zipfileset file="${CaPublicKeyOld}" />
		</jar>
	</target>

	<target name="sign_jar" depends="add_ca_certificates_to_jar" if="codeSigningPropertiesAvailable">
		<signjar destDir="${buildPath}" alias="${CodeSigningKeyAlias}" keystore="${CodeSigningKeyStore}" storepass="${CodeSigningKeyStorePassword}" keypass="${CodeSigningKeyPassword}" preservelastmodified="true" tsaurl="${TsaUrl}">
			<path>
				<fileset dir="${buildPath}" includes="ConsoleMailer-${build.version}.jar" />
			</path>
		</signjar>
	</target>
</project>
